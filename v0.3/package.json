{
  "name": "h-karate-v3",
  "version": "3.0.0",
  "description": "H Karate — Professional Tournament Scoring System v3 Red Belt",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron": "^37.2.6",
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.hkarate.scoring",
    "productName": "H Karate Scoring",
    "directories": { "output": "dist" },
    "files": ["**/*", "!node_modules", "!dist", "!v0.1", "!v0.2"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "extraResources": [{ "from": "data/", "to": "data/" }]
  },
  "author": "Hosam Sheboun",
  "license": "MIT"
}
