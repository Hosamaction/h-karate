{
  "name": "karate-scoring-app",
  "version": "1.0.0",
  "description": "Professional Karate Scoring System for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev": "electron . --dev",
    "security-audit": "npm audit",
    "security-fix": "npm audit fix"
  },
  "dependencies": {
    "electron": "^37.2.6",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.karate.scoring",
    "productName": "Karate Scoring System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules",
      "!dist"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "keywords": [
    "karate",
    "scoring",
    "tournament",
    "martial-arts"
  ],
  "author": "Karate Scoring System",
  "license": "MIT"
}
